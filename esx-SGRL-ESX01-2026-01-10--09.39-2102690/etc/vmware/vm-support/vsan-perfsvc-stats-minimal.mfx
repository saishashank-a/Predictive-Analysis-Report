% Manifest name: VSANPerfStatsMinimal
% Manifest group: Storage
% Manifest default: Disabled
% Manifest tag: storage,vsanperfstatsmin
# action Options file/command
# Dump vsan performance stats metrics crucial last 2 hours for debugging


run TIMEOUT=1200,IGNORE_ERROR python /usr/lib/vmware/vsan/perfsvc/vsan-perfsvc-status.pyc --unit hour perf_stats_with_dump 2
