% Manifest name: VSANObfuscateLSOMTraces
% Manifest group: Storage
% Manifest default: Disabled
% Manifest tag: storage,vsan
# action Options file/command


run TIMEOUT=3600,IGNORE_ERROR,RELOCATE=/var/log/vsantraces/vsantracesLSOM.log python /usr/lib/vmware/vsan/bin/vsanTraceCollector.pyc --obfuscate -t LSOM --flat -m Storage:VSANObfuscateLSOMTraces
